# ---------------------------------------------------------------- local
# Leave everything unset and the app runs with no configuration at all:
#   files    -> ./.data/blobs   (served by /api/files/*)
#   metadata -> ./.data/db.json
#   access   -> open to anyone who can reach the port

# Shared lab password. Set this and the whole site sits behind one password;
# leave it unset and the middleware steps aside entirely.
# Changing it invalidates every existing session.
# LAB_PASSWORD=

# ------------------------------------------------------------- vercel
# Add a Blob store to the Vercel project and this appears automatically.
# Its presence switches uploads to browser -> Blob direct upload, which is the
# only way past the 4.5MB serverless request-body limit.
# BLOB_READ_WRITE_TOKEN=

# Add a Neon Postgres store and this appears automatically. Its presence
# switches metadata storage off the (ephemeral) filesystem and into Postgres.
# The table is created on first use.
# DATABASE_URL=
